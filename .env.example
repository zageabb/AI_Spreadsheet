# Application
APP_ENV=development
APP_DEBUG=true

# Storage backend options: json | postgres
# JSON remains the default local-first backend.
STORAGE_BACKEND=json
JSON_DATA_DIR=./data

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_spreadsheet
POSTGRES_USER=spreadsheet_user
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=prefer

# Collaboration server (scaffold)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Email service (scaffold)
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
