# Application
APP_ENV=development
APP_DEBUG=true

# Storage backend options: json | postgres
# JSON remains the default local-first backend.
STORAGE_BACKEND=json
JSON_DATA_DIR=./data

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_spreadsheet
POSTGRES_USER=spreadsheet_user
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_APPLICATION_NAME=ai_spreadsheet

# Collaboration server (optional; blank URL keeps the desktop local-only)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Leave blank for local-only desktop operation.
COLLAB_SERVER_URL=
# Must match the desktop AUTH_SESSION_SECRET for collaboration authentication.
# Shared collaboration requires server-visible JSON files or PostgreSQL storage.
COLLAB_PRESENCE_TTL_SECONDS=90

# Email service
EMAIL_ENABLED=true
# Set true for safe local testing (captures/prints emails instead of delivery).
EMAIL_DEV_MODE=true
# Supported providers: smtp | api
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# API-based provider settings (used when EMAIL_PROVIDER=api)
EMAIL_API_ENDPOINT=
EMAIL_API_TOKEN=
EMAIL_API_TIMEOUT_SECONDS=10

# Optional app URL used by notification links.
APP_BASE_URL=http://127.0.0.1:8000

# Excel OOXML passthrough package limit (50 MiB default).
OOXML_PASSTHROUGH_MAX_BYTES=52428800

# User-authored validated Python formula modules.
CUSTOM_FUNCTIONS_DIR=./plugins/user

# Crash recovery (local JSON snapshots; never overwrites the primary workbook).
AUTOSAVE_ENABLED=true
AUTOSAVE_INTERVAL_SECONDS=60
AUTOSAVE_DIR=./data/autosave

# Grounded spreadsheet AI assistant (selection context only; proposal-only edits).
AI_ENABLED=false
# Supported providers: ollama | openai_compatible
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:14b
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_MAX_CONTEXT_CELLS=200
AI_MAX_PROPOSALS=50

# Analytical data connections. Workbooks store only the reference name.
# Configure real secret values outside source control, for example:
# DATA_CREDENTIAL_REPORTS={"type":"bearer","token":"replace_at_runtime"}
# DATA_CREDENTIAL_REPORTING_DB={"host":"localhost","dbname":"reporting","user":"reader","password":"replace_at_runtime","sslmode":"require"}
DATA_ALLOW_INSECURE_HTTP=false

# Authentication
AUTH_IDENTITY_PROVIDER=local
# Hashed local accounts are stored here when STORAGE_BACKEND=json.
AUTH_USER_STORE=./data/users.json
# Use a long random secret for session token signing.
AUTH_SESSION_SECRET=replace_with_long_random_secret
AUTH_SESSION_TTL_SECONDS=28800
# Optional separate signing key for password resets; defaults to session secret.
AUTH_RESET_SECRET=
AUTH_RESET_TTL_SECONDS=1800
AUTH_PASSWORD_ITERATIONS=260000
# Optional pepper value for password hashes (keep secret, do not commit real value).
AUTH_PASSWORD_PEPPER=
